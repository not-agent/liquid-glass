{
  "name": "@taehalim/liquid-glass",
  "version": "0.1.1",
  "description": "Liquid Glass effect for Astro and browser UI, using SVG displacement filters and backdrop-filter.",
  "type": "module",
  "license": "MIT",
  "author": "Taeha Lim",
  "homepage": "https://github.com/not-agent/liquid-glass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/not-agent/liquid-glass.git"
  },
  "bugs": {
    "url": "https://github.com/not-agent/liquid-glass/issues"
  },
  "keywords": [
    "astro",
    "liquid-glass",
    "glassmorphism",
    "backdrop-filter",
    "svg-filter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "sideEffects": [
    "./dist/styles.css",
    "./dist/auto.js"
  ],
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./astro": "./dist/astro/LiquidGlass.astro",
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "astro": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
